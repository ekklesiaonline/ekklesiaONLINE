  "files": [
    {
      "path": "cover.html",
      "mimeType": "text/html",
      "title": "cover.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'IBM Plex Sans', sans-serif; color: #161616; background-color: #F4F5F6; }\n    .slide-container {\n      width: 1280px;\n      min-height: 720px;\n      background: #F4F5F6;\n      display: flex;\n      flex-direction: column;\n      padding: 48px;\n      position: relative;\n    }\n    .motif-tr { position: absolute; top: 24px; right: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .motif-bl { position: absolute; bottom: 24px; left: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .content { flex: 1; display: flex; align-items: center; justify-content: space-between; }\n    .title-area { width: 66%; }\n    .title { font-size: 56px; font-weight: 500; line-height: 1.1; margin-bottom: 24px; }\n    .subtitle { font-size: 24px; color: #525252; font-family: 'IBM Plex Mono'; border-left: 4px solid #D94E18; padding-left: 20px; }\n    .graphic-area { width: 30%; display: flex; justify-content: flex-end; align-items: center; }\n    .large-motif { font-size: 240px; color: #C6C6C6; font-family: 'IBM Plex Mono'; }\n    .footer { position: absolute; bottom: 48px; right: 48px; font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif-tr\">+</div>\n    <div class=\"motif-bl\">+</div>\n    <div class=\"content\">\n      <div class=\"title-area\">\n        <h1 class=\"title\">ekklesiaRD<br>Authorization & Security Review</h1>\n        <p class=\"subtitle\">A Layered Boundary System</p>\n      </div>\n      <div class=\"graphic-area\">\n        <div class=\"large-motif\">+</div>\n      </div>\n    </div>\n    <div class=\"footer\">PAGE 01</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "model.html",
      "mimeType": "text/html",
      "title": "model.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'IBM Plex Sans', sans-serif; color: #161616; background-color: #F4F5F6; }\n    .slide-container { width: 1280px; min-height: 720px; background: #F4F5F6; display: flex; flex-direction: column; padding: 48px; position: relative; }\n    .motif-tr { position: absolute; top: 24px; right: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .motif-bl { position: absolute; bottom: 24px; left: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .header { border-bottom: 1px solid #C6C6C6; padding-bottom: 16px; margin-bottom: 48px; }\n    .slide-title { font-size: 36px; font-weight: 500; }\n    .content { flex: 1; display: flex; flex-direction: column; justify-content: center; }\n    .flow-container { display: flex; align-items: center; justify-content: space-between; }\n    .flow-step { width: 180px; height: 140px; border: 1px solid #C6C6C6; display: flex; flex-direction: column; padding: 12px; position: relative; background: #FFFFFF; }\n    .flow-step.active { border-color: #D94E18; border-width: 2px; }\n    .step-num { font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; margin-bottom: 8px; }\n    .step-title { font-size: 18px; font-weight: 500; line-height: 1.2; }\n    .flow-arrow { width: 40px; height: 1px; background: #C6C6C6; position: relative; }\n    .flow-arrow::after { content: ''; position: absolute; right: 0; top: -3px; border: 4px solid transparent; border-left-color: #C6C6C6; }\n    .desc-area { margin-top: 64px; border: 1px solid #C6C6C6; padding: 24px; background: #E0E3E5; }\n    .desc-title { font-family: 'IBM Plex Mono'; font-size: 16px; font-weight: 500; margin-bottom: 12px; color: #D94E18; }\n    .desc-text { font-size: 20px; line-height: 1.5; }\n    .footer { position: absolute; bottom: 48px; right: 48px; font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif-tr\">+</div>\n    <div class=\"motif-bl\">+</div>\n    <div class=\"header\"><h2 class=\"slide-title\">The Authorization Request Path</h2></div>\n    <div class=\"content\">\n      <div class=\"flow-container\">\n        <div class=\"flow-step\"><div class=\"step-num\">01</div><div class=\"step-title\">Shield Auth<br>& Gates</div></div>\n        <div class=\"flow-arrow\"></div>\n        <div class=\"flow-step\"><div class=\"step-num\">02</div><div class=\"step-title\">Route-Level<br>Permissions</div></div>\n        <div class=\"flow-arrow\"></div>\n        <div class=\"flow-step\"><div class=\"step-num\">03</div><div class=\"step-title\">Boundary<br>Scope Filters</div></div>\n        <div class=\"flow-arrow\"></div>\n        <div class=\"flow-step\"><div class=\"step-num\">04</div><div class=\"step-title\">Hierarchy<br>Guard</div></div>\n        <div class=\"flow-arrow\"></div>\n        <div class=\"flow-step active\"><div class=\"step-num\">05</div><div class=\"step-title\">Domain<br>Mutation</div></div>\n      </div>\n      <div class=\"desc-area\">\n        <div class=\"desc-title\">DEFENSE IN DEPTH</div>\n        <p class=\"desc-text\">Every request must pass multiple independent layers. Permission identifies the <strong>action category</strong>, Scope enforces <strong>geographic boundaries</strong>, and Hierarchy protects <strong>administrator records</strong>. A failure at any layer terminates the request before mutation.</p>\n      </div>\n    </div>\n    <div class=\"footer\">PAGE 02</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "hierarchy.html",
      "mimeType": "text/html",
      "title": "hierarchy.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'IBM Plex Sans', sans-serif; color: #161616; background-color: #F4F5F6; }\n    .slide-container { width: 1280px; min-height: 720px; background: #F4F5F6; display: flex; flex-direction: column; padding: 48px; position: relative; }\n    .motif-tr { position: absolute; top: 24px; right: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .motif-bl { position: absolute; bottom: 24px; left: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .header { border-bottom: 1px solid #C6C6C6; padding-bottom: 16px; margin-bottom: 48px; }\n    .slide-title { font-size: 36px; font-weight: 500; }\n    .content { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }\n    .rules-column { background: #E0E3E5; border: 1px solid #C6C6C6; padding: 24px; }\n    .code-block { font-family: 'IBM Plex Mono'; font-size: 18px; line-height: 1.6; }\n    .code-comment { color: #525252; }\n    .priority-list { list-style: none; margin-top: 24px; font-family: 'IBM Plex Mono'; }\n    .priority-item { margin-bottom: 12px; display: flex; }\n    .priority-label { width: 180px; color: #D94E18; }\n    .expl-column { display: flex; flex-direction: column; justify-content: center; }\n    .expl-item { margin-bottom: 32px; }\n    .expl-title { font-size: 22px; font-weight: 500; margin-bottom: 12px; color: #D94E18; }\n    .expl-text { font-size: 20px; line-height: 1.5; color: #525252; }\n    .footer { position: absolute; bottom: 48px; right: 48px; font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif-tr\">+</div>\n    <div class=\"motif-bl\">+</div>\n    <div class=\"header\"><h2 class=\"slide-title\">AdminHierarchyGuard: Exact Rules</h2></div>\n    <div class=\"content\">\n      <div class=\"rules-column\">\n        <div class=\"code-block\">\n          <p class=\"code-comment\">// Priority Hierarchy</p>\n          <ul class=\"priority-list\">\n            <li class=\"priority-item\"><span class=\"priority-label\">systemadmin</span> <span>= 4</span></li>\n            <li class=\"priority-item\"><span class=\"priority-label\">provinceadmin</span> <span>= 3</span></li>\n            <li class=\"priority-item\"><span class=\"priority-label\">dioceseadmin</span> <span>= 2</span></li>\n            <li class=\"priority-item\"><span class=\"priority-label\">parishadmin</span> <span>= 1</span></li>\n            <li class=\"priority-item\"><span class=\"priority-label\">others</span> <span>= 0</span></li>\n          </ul>\n          <br>\n          <p class=\"code-comment\">// Comparison Code</p>\n          <p>if (targetPriority > actorPriority) {</p>\n          <p>&nbsp;&nbsp;return 'HIERARCHY';</p>\n          <p>}</p>\n        </div>\n      </div>\n      <div class=\"expl-column\">\n        <div class=\"expl-item\">\n          <h3 class=\"expl-title\">Outranking Protection</h3>\n          <p class=\"expl-text\">Prevents lower-tier admins from modifying, deactivating, or deleting accounts of higher-tier administrators.</p>\n        </div>\n        <div class=\"expl-item\">\n          <h3 class=\"expl-title\">Multi-Group Resolution</h3>\n          <p class=\"expl-text\">Uses the highest priority among all assigned groups for an actor or target.</p>\n        </div>\n        <div class=\"expl-item\">\n          <h3 class=\"expl-title\">Self-Targeting Gate</h3>\n          <p class=\"expl-text\">Independent of hierarchy; destructive operations against one's own account are explicitly blocked.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"footer\">PAGE 03</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "scopes.html",
      "mimeType": "text/html",
      "title": "scopes.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'IBM Plex Sans', sans-serif; color: #161616; background-color: #F4F5F6; }\n    .slide-container { width: 1280px; min-height: 720px; background: #F4F5F6; display: flex; flex-direction: column; padding: 48px; position: relative; }\n    .motif-tr { position: absolute; top: 24px; right: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .motif-bl { position: absolute; bottom: 24px; left: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .header { border-bottom: 1px solid #C6C6C6; padding-bottom: 16px; margin-bottom: 48px; }\n    .slide-title { font-size: 36px; font-weight: 500; }\n    .content { flex: 1; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 24px; }\n    .quadrant { border: 1px solid #C6C6C6; padding: 24px; background: #FFFFFF; display: flex; flex-direction: column; }\n    .quad-title { font-family: 'IBM Plex Mono'; font-size: 16px; font-weight: 500; color: #D94E18; margin-bottom: 16px; text-transform: uppercase; }\n    .quad-label { font-size: 20px; font-weight: 500; margin-bottom: 12px; }\n    .quad-text { font-size: 18px; line-height: 1.4; color: #525252; }\n    .footer { position: absolute; bottom: 48px; right: 48px; font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif-tr\">+</div>\n    <div class=\"motif-bl\">+</div>\n    <div class=\"header\"><h2 class=\"slide-title\">Geographic & Operational Boundaries</h2></div>\n    <div class=\"content\">\n      <div class=\"quadrant\">\n        <div class=\"quad-title\">Province Boundary</div>\n        <div class=\"quad-label\">ProvinceScopeFilter</div>\n        <p class=\"quad-text\">Validates that dioceses and parishes in GET/POST parameters belong to the actor's resolved province.</p>\n      </div>\n      <div class=\"quadrant\">\n        <div class=\"quad-title\">Diocese Boundary</div>\n        <div class=\"quad-label\">DiocesanScopeFilter</div>\n        <p class=\"quad-text\">Restores compatibility for legacy route declarations while sharing DioceseScopeFilter enforcement logic.</p>\n      </div>\n      <div class=\"quadrant\">\n        <div class=\"quad-title\">Parish Boundary</div>\n        <div class=\"quad-label\">ParishScopeFilter</div>\n        <p class=\"quad-text\">Enforces a valid selected or profile parish context for operator workflows; bypassed by higher-level admins.</p>\n      </div>\n      <div class=\"quadrant\">\n        <div class=\"quad-title\">Operational Boundary</div>\n        <div class=\"quad-label\">Functional Gates</div>\n        <p class=\"quad-text\">Blocks diocesan admins from parish-operator modules and restricts province/diocese admins from finance workflows.</p>\n      </div>\n    </div>\n    <div class=\"footer\">PAGE 04</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "audit_flow.html",
      "mimeType": "text/html",
      "title": "audit_flow.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'IBM Plex Sans', sans-serif; color: #161616; background-color: #F4F5F6; }\n    .slide-container { width: 1280px; min-height: 720px; background: #F4F5F6; display: flex; flex-direction: column; padding: 48px; position: relative; }\n    .motif-tr { position: absolute; top: 24px; right: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .motif-bl { position: absolute; bottom: 24px; left: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .header { border-bottom: 1px solid #C6C6C6; padding-bottom: 16px; margin-bottom: 48px; }\n    .slide-title { font-size: 36px; font-weight: 500; }\n    .content { flex: 1; display: flex; }\n    .seq-container { width: 100%; display: flex; flex-direction: column; }\n    .seq-step { display: flex; align-items: flex-start; margin-bottom: 24px; }\n    .seq-marker { width: 4px; height: 4px; background: #D94E18; margin-top: 10px; margin-right: 24px; }\n    .seq-content { border-left: 1px solid #C6C6C6; padding-left: 24px; }\n    .seq-title { font-family: 'IBM Plex Mono'; font-size: 18px; font-weight: 500; margin-bottom: 8px; color: #161616; }\n    .seq-text { font-size: 20px; line-height: 1.4; color: #525252; }\n    .footer { position: absolute; bottom: 48px; right: 48px; font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif-tr\">+</div>\n    <div class=\"motif-bl\">+</div>\n    <div class=\"header\"><h2 class=\"slide-title\">Uniform Security Auditing</h2></div>\n    <div class=\"content\">\n      <div class=\"seq-container\">\n        <div class=\"seq-step\">\n          <div class=\"seq-marker\"></div>\n          <div class=\"seq-content\">\n            <h3 class=\"seq-title\">Centralized logAuthorizationDenial()</h3>\n            <p class=\"seq-text\">New AuditService API provides a uniform contract for all security rejections across filters and controllers.</p>\n          </div>\n        </div>\n        <div class=\"seq-step\">\n          <div class=\"seq-marker\"></div>\n          <div class=\"seq-content\">\n            <h3 class=\"seq-title\">Automatic Rate Limiting</h3>\n            <p class=\"seq-text\">Restricts authorization-denied logging to 10 events per hour per user, preventing audit-log flooding during probes.</p>\n          </div>\n        </div>\n        <div class=\"seq-step\">\n          <div class=\"seq-marker\"></div>\n          <div class=\"seq-content\">\n            <h3 class=\"seq-title\">Rich Security Metadata</h3>\n            <p class=\"seq-text\">Records actor, target, path, method, and specific denial codes (e.g., PROVINCE_SCOPE_DENIED) for forensic analysis.</p>\n          </div>\n        </div>\n        <div class=\"seq-step\">\n          <div class=\"seq-marker\"></div>\n          <div class=\"seq-content\">\n            <h3 class=\"seq-title\">Hierarchy Block Visibility</h3>\n            <p class=\"seq-text\">Integrated security.hierarchy_block into standard security-event dashboards and statistics queries.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"footer\">PAGE 05</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "gaps.html",
      "mimeType": "text/html",
      "title": "gaps.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'IBM Plex Sans', sans-serif; color: #161616; background-color: #F4F5F6; }\n    .slide-container { width: 1280px; min-height: 720px; background: #F4F5F6; display: flex; flex-direction: column; padding: 48px; position: relative; }\n    .motif-tr { position: absolute; top: 24px; right: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .motif-bl { position: absolute; bottom: 24px; left: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .header { border-bottom: 1px solid #C6C6C6; padding-bottom: 16px; margin-bottom: 48px; }\n    .slide-title { font-size: 36px; font-weight: 500; }\n    .content { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: #C6C6C6; border: 1px solid #C6C6C6; }\n    .pane { background: #F4F5F6; padding: 32px; display: flex; flex-direction: column; }\n    .pane-title { font-family: 'IBM Plex Mono'; font-size: 16px; font-weight: 500; margin-bottom: 32px; text-transform: uppercase; }\n    .gap-pane .pane-title { color: #D94E18; }\n    .fix-pane .pane-title { color: #161616; }\n    .item { margin-bottom: 40px; }\n    .item-label { font-size: 20px; font-weight: 500; margin-bottom: 8px; }\n    .item-text { font-size: 18px; line-height: 1.4; color: #525252; }\n    .footer { position: absolute; bottom: 48px; right: 48px; font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif-tr\">+</div>\n    <div class=\"motif-bl\">+</div>\n    <div class=\"header\"><h2 class=\"slide-title\">Addressed Enforcement Gaps</h2></div>\n    <div class=\"content\">\n      <div class=\"pane gap-pane\">\n        <div class=\"pane-title\">Identified Gaps</div>\n        <div class=\"item\">\n          <div class=\"item-label\">Missing Diocesan Implementation</div>\n          <p class=\"item-text\">Configured filter alias pointed to a non-existent class, potentially breaking routes or boundaries.</p>\n        </div>\n        <div class=\"item\">\n          <div class=\"item-label\">Silent Scope Rejections</div>\n          <p class=\"item-text\">Global boundary filters returned errors to users without creating application-level audit events.</p>\n        </div>\n        <div class=\"item\">\n          <div class=\"item-label\">Dashboard Visibility Gap</div>\n          <p class=\"item-text\">Hierarchy blocks were excluded from security dashboards despite being high-signal events.</p>\n        </div>\n      </div>\n      <div class=\"pane fix-pane\">\n        <div class=\"pane-title\">Applied Correctives</div>\n        <div class=\"item\">\n          <div class=\"item-label\">Restored Compatibility</div>\n          <p class=\"item-text\">Implemented DiocesanScopeFilter as a delegating alias to ensure uniform enforcement across all routes.</p>\n        </div>\n        <div class=\"item\">\n          <div class=\"item-label\">Uniform Denial Logging</div>\n          <p class=\"item-text\">Standardized logging across all boundary filters and route-level permission checks via AuditService.</p>\n        </div>\n        <div class=\"item\">\n          <div class=\"item-label\">Unified Security Dashboard</div>\n          <p class=\"item-text\">Included hierarchy blocks in statistics and quick filters, providing immediate visibility to administrators.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"footer\">PAGE 06</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "recommendations.html",
      "mimeType": "text/html",
      "title": "recommendations.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono&display=swap\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'IBM Plex Sans', sans-serif; color: #161616; background-color: #F4F5F6; }\n    .slide-container { width: 1280px; min-height: 720px; background: #F4F5F6; display: flex; flex-direction: column; padding: 48px; position: relative; }\n    .motif-tr { position: absolute; top: 24px; right: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .motif-bl { position: absolute; bottom: 24px; left: 24px; color: #C6C6C6; font-family: 'IBM Plex Mono'; font-size: 24px; }\n    .header { border-bottom: 1px solid #C6C6C6; padding-bottom: 16px; margin-bottom: 48px; }\n    .slide-title { font-size: 36px; font-weight: 500; }\n    .content { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }\n    .rec-card { border: 1px solid #C6C6C6; padding: 32px; background: #FFFFFF; }\n    .rec-title { font-family: 'IBM Plex Mono'; font-size: 18px; font-weight: 500; margin-bottom: 20px; color: #D94E18; }\n    .rec-list { list-style: none; }\n    .rec-item { font-size: 18px; line-height: 1.6; margin-bottom: 16px; position: relative; padding-left: 24px; }\n    .rec-item::before { content: '→'; position: absolute; left: 0; color: #D94E18; }\n    .footer { position: absolute; bottom: 48px; right: 48px; font-family: 'IBM Plex Mono'; font-size: 14px; color: #525252; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif-tr\">+</div>\n    <div class=\"motif-bl\">+</div>\n    <div class=\"header\"><h2 class=\"slide-title\">Security Audit Recommendations</h2></div>\n    <div class=\"content\">\n      <div class=\"rec-card\">\n        <div class=\"rec-title\">Short-Term Observability</div>\n        <ul class=\"rec-list\">\n          <li class=\"rec-item\">Monitor security-event dashboard for spikes in PROVINCE_SCOPE_DENIED.</li>\n          <li class=\"rec-item\">Review rate-limited audit logs to identify potential automated traversal attempts.</li>\n          <li class=\"rec-item\">Configure alerts for hierarchy violations targeting system-admin accounts.</li>\n        </ul>\n      </div>\n      <div class=\"rec-card\">\n        <div class=\"rec-title\">Long-Term Enforcement</div>\n        <ul class=\"rec-list\">\n          <li class=\"rec-item\">Extend ParishScopeFilter to validate session parish against authorized profile scope.</li>\n          <li class=\"rec-item\">Centralize all geographic boundary logic into a singleton ParishScopeValidator.</li>\n          <li class=\"rec-item\">Standardize audit event \"old_values\" capturing for all protected mutations.</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"footer\">PAGE 07</div>\n  </div>\n</body>\n</html>\n"
