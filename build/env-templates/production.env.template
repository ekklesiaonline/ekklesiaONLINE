# ekklesiaONLINE — PRODUCTION environment template
# Copy to `.env` on the production host. Replace EVERY placeholder.
# Never commit the resulting .env. Verify with key-presence checks only —
# do not print resolved secrets. Prefer a secret manager over host files
# where the platform allows.

# ENVIRONMENT — MUST be production.
CI_ENVIRONMENT = production

# APPLICATION — HTTPS only, canonical public URL.
app.baseURL = 'https://CHANGE_ME.example/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = true
# List trusted reverse-proxy IPs/CIDRs when TLS terminates upstream.
# app.proxyIPs = '10.0.0.0/8,...'

# DATABASE (MySQL 8) — production credentials, unique to this environment.
database.default.hostname = 'CHANGE_ME'
database.default.database = 'CHANGE_ME'
database.default.username = 'CHANGE_ME'
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# ENCRYPTION — generate INDEPENDENT high-entropy values; MUST differ from
# staging and every other environment:
#   php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)) . PHP_EOL;"
# Store in the secret manager; do not reuse dev/test/example values.
encryption.key = 'CHANGE_ME'
encryption.blindIndexKey = 'CHANGE_ME'
encryption.previousKeys =

# LOGGING AND MONITORING — production logger threshold (4 = warning+error
# typical; confirm against ops policy).
logger.threshold = 4
monitoring.enabled = true
monitoring.fileLogEnabled = true
monitoring.auditLogEnabled = true
monitoring.auditDbEnabled = true
monitoring.slowRequestMs = 800
monitoring.slowQueryMs = 100

# RATE LIMITS AND SESSION SECURITY — tune per traffic; values below are
# the .env.example defaults.
security.apiRateLimitPerWindow = 60
security.apiRateLimitWindowSeconds = 60
security.apiRateLimitAnonPerWindow = 20
security.loginRateLimitPerWindow = 5
security.loginRateLimitWindowSeconds = 900
# MUST be absent or 0/false in production — ProductionSecurityPosture logs
# critical on every boot if truthy.
security.disableDeviceVerificationForTesting = 0
security.trustedDeviceTtlDays = 30
session.maxConcurrent = 3
# Login email second factor for admin groups: off | admins | all.
security.login_2fa_scope = admins
MFA_REQUIRED_FOR_ADMIN_OPS = true
SYSTEM_ADMIN_PRIMARY_TRANSFER_OTP_ENABLED = true

# DOMAIN POLICIES — enable only after duplicate family memberships are
# remediated. Audit query:
#   SELECT user_id, COUNT(DISTINCT family_id) AS family_count
#   FROM family_member GROUP BY user_id HAVING family_count > 1;
families.enforceSingleFamilyMembership = 0

# EMAIL — production SMTP with SPF/DKIM/DMARC-aligned sender.
# See docs/EMAIL_DELIVERABILITY.md. Credential-bearing mail (activation,
# magic link, OTP, device verification, password reset) uses the System
# transport via EmailScopeService::credentialMailer regardless of scope.
email.protocol = smtp
email.fromEmail = 'CHANGE_ME@example.org'
email.fromName = 'ekklesiaONLINE'
email.SMTPHost = 'CHANGE_ME'
email.SMTPUser = 'CHANGE_ME'
email.SMTPPass = 'CHANGE_ME'
email.SMTPPort = 587
email.SMTPTimeout = 5
email.SMTPCrypto = tls
# Optional: Gmail API OAuth2 transport (only if used). Never commit real values.
# email.googleClientId =
# email.googleClientSecret =

# DATABASE BACKUPS — dedicated backup credentials preferred (read-only
# replication user where available). Required by backup/restore --check.
backup.db.host = 'CHANGE_ME'
backup.db.port = 3306
backup.db.name = 'CHANGE_ME'
backup.db.user = 'CHANGE_ME'
backup.db.pass = 'CHANGE_ME'
backup.retentionDays = 30
backup.outputDir = writable/backups

# SMS — configure Twilio for production delivery, or keep log_only and
# accept that SMS follow-up actions will not send.
sms.provider = log_only
sms.twilio_from =
sms.twilio_sid =
sms.twilio_token =
