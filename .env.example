# Copy this file to .env and replace every CHANGE_ME value before deployment.
# Never commit the resulting .env file.

# ENVIRONMENT
CI_ENVIRONMENT = development

# APPLICATION
app.baseURL = 'https://CHANGE_ME.example/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false
# Configure Config\App::$proxyIPs when TLS terminates at a trusted reverse proxy.

# DATABASE (MySQL 8)
database.default.hostname = 'CHANGE_ME'
database.default.database = 'CHANGE_ME'
database.default.username = 'CHANGE_ME'
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# ENCRYPTION
# Generate independent high-entropy values; do not reuse the examples from tests.
encryption.key = 'CHANGE_ME'
encryption.blindIndexKey = 'CHANGE_ME'
encryption.previousKeys =

# LOGGING AND MONITORING
logger.threshold = 4
monitoring.enabled = true
monitoring.fileLogEnabled = true
monitoring.auditLogEnabled = true
monitoring.auditDbEnabled = true
monitoring.slowRequestMs = 800
monitoring.slowQueryMs = 100

# RATE LIMITS AND SESSION SECURITY
security.apiRateLimitPerWindow = 60
security.apiRateLimitWindowSeconds = 60
security.apiRateLimitAnonPerWindow = 20
security.loginRateLimitPerWindow = 5
security.loginRateLimitWindowSeconds = 900
security.disableDeviceVerificationForTesting = 0
# Days a verified "trusted device" stays trusted (hashed cookie, revocable).
security.trustedDeviceTtlDays = 30
session.maxConcurrent = 3
MFA_REQUIRED_FOR_ADMIN_OPS = true
SYSTEM_ADMIN_PRIMARY_TRANSFER_OTP_ENABLED = true

# DOMAIN POLICIES
families.enforceSingleFamilyMembership = 0

# EMAIL
email.protocol = smtp
email.fromEmail = 'CHANGE_ME@example.invalid'
email.fromName = 'ekklesiaRD'
email.SMTPHost = 'CHANGE_ME'
email.SMTPUser = 'CHANGE_ME'
email.SMTPPass = 'CHANGE_ME'
email.SMTPPort = 587
email.SMTPTimeout = 5
email.SMTPCrypto = tls

# DATABASE BACKUPS
backup.db.host = 'CHANGE_ME'
backup.db.port = 3306
backup.db.name = 'CHANGE_ME'
backup.db.user = 'CHANGE_ME'
backup.db.pass = 'CHANGE_ME'
backup.retentionDays = 30
backup.outputDir = writable/backups

# OPTIONAL SMS
sms.provider = log_only
sms.twilio_from =
sms.twilio_sid =
sms.twilio_token =
