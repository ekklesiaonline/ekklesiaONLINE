{
	"folders": [
		{
			"path": ".",
			"name": "ekklesiaONLINE"
		}
	],
	"settings": {
		"editor.defaultFormatter": "vscode.json-language-features",
		"editor.formatOnSave": true,
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.detectIndentation": true,
		"editor.rulers": [
			120
		],
		"files.eol": "\n",
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"files.exclude": {
			"**/vendor/**": true,
			"**/node_modules/**": true,
			"**/writable/cache/**": true,
			"**/writable/debugbar/**": true,
			"**/writable/logs/**": true,
			"**/writable/session/**": true,
			"**/writable/uploads/**": true,
			"**/.git": true,
			"**/.DS_Store": true
		},
		"files.associations": {
			"*.php": "php",
			"*.html": "html",
			"*.tpl": "php"
		},
		"search.exclude": {
			"**/vendor/**": true,
			"**/node_modules/**": true,
			"**/writable/**": true,
			"**/.git/**": true,
			"**/public/assets/vendor/**": true
		},
		"php.validate.enable": true,
		"php.validate.executablePath": "",
		"php.validate.run": "onType",
		"php.intelephense.diagnostics.undefinedTypes": false,
		"php.suggest.basic": false,
		"[php]": {
			"editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
			"editor.formatOnSave": true
		},
		"[json]": {
			"editor.defaultFormatter": "vscode.json-language-features",
			"editor.formatOnSave": true
		},
		"[javascript]": {
			"editor.defaultFormatter": "vscode.typescript-language-features",
			"editor.formatOnSave": true
		},
		"emmet.includeLanguages": {
			"php": "html"
		},
		"emmet.syntaxProfiles": {
			"php": "html"
		},
		"intelephense.files.exclude": [
			"**/vendor/**",
			"**/.git/**",
			"**/node_modules/**",
			"**/writable/**"
		],
		"intelephense.files.include": [
			"app/**/*.php",
			"Province/**/*.php",
			"Diocese/**/*.php",
			"Clergy/**/*.php",
			"Parish/**/*.php",
			"Worship/**/*.php",
			"Finance/**/*.php",
			"Volunteer/**/*.php",
			"MemberPortal/**/*.php",
			"system/**/*.php"
		],
		"workbench.editor.enablePreview": false,
		"git.ignoreLimitWarning": true,
		"git.enableSmartCommit": true
	},
	"extensions": {
		"recommendations": [
			"bmewburn.vscode-intelephense-client",
			"xdebug.php-debug",
			"editorconfig.editorconfig",
			"dbaeumer.vscode-eslint",
			"mehedidracula.php-namespace-resolver",
			"ryanlukas.codeigniter4-snippets",
			"abusaidm.html-snippets",
			"zignd.html-css-class-completion",
			"ecmel.vscode-html-bootstrap",
			"eamodio.gitlens",
			"mhutchie.git-graph",
			"gruntfuggly.todo-tree",
			"mtxr.sqltools",
			"mtxr.sqltools-driver-mysql"
		],
		"unwantedRecommendations": [
			"felixfbecker.php-intellisense"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Listen for Xdebug",
				"type": "php",
				"request": "launch",
				"port": 9003,
				"pathMappings": {
					"/var/www/html": "${workspaceFolder}"
				},
				"log": false,
				"xdebugSettings": {
					"max_children": 128,
					"max_data": 512,
					"max_depth": 3
				}
			},
			{
				"name": "Launch built-in server",
				"type": "php",
				"request": "launch",
				"runtimeExecutable": "php",
				"runtimeArgs": [
					"-S",
					"localhost:8080",
					"-t",
					"${workspaceFolder}/public"
				],
				"port": 9003,
				"serverReadyAction": {
					"action": "openExternally",
					"pattern": "^\\*\\s+Running on http://localhost:8080",
					"uriFormat": "http://localhost:8080"
				}
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "CI4: Serve app",
				"type": "shell",
				"command": "php spark serve",
				"group": "build",
				"isBackground": true,
				"problemMatcher": []
			},
			{
				"label": "CI4: Run tests",
				"type": "shell",
				"command": "vendor/bin/phpunit --no-coverage",
				"group": {
					"kind": "test",
					"isDefault": true
				},
				"problemMatcher": []
			},
			{
				"label": "CI4: Lint PHP",
				"type": "shell",
				"command": "php -l app/Config/Routes.php",
				"group": "build",
				"problemMatcher": []
			},
			{
				"label": "CI4: Seed database",
				"type": "shell",
				"command": "php spark db:seed DatabaseSeeder",
				"group": "build",
				"problemMatcher": []
			},
			{
				"label": "CI4: Audit people affiliation drift",
				"type": "shell",
				"command": "php spark people:audit-affiliation-drift",
				"group": "build",
				"problemMatcher": []
			}
		]
	}
}