# ekklesiaONLINE — STAGING environment template
# Copy to `.env` on the staging host. Replace EVERY placeholder.
# Never commit the resulting .env. Verify with key-presence checks only —
# do not print resolved secrets.

# ENVIRONMENT — MUST be production on staging (engages Cookie.secure,
# forceGlobalSecureRequests, CSRF redirect defaults, and the
# ProductionSecurityPosture boot tripwire).
CI_ENVIRONMENT = production

# APPLICATION — HTTPS only. Must match the URL operators browse to.
app.baseURL = 'https://CHANGE_ME-staging.example/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = true
# REQUIRED: clean URLs without /index.php/ in generated links and redirects.
# App::$indexPage defaults to 'index.php'; empty here because .htaccess rewrites.
app.indexPage =
# Trusted reverse proxies: App::$proxyIPs is an array mapping each proxy
# IP/CIDR to its client-IP header (e.g. '10.0.0.0/8' => 'X-Forwarded-For').
# Configure it in app/Config/App.php (or a Registrar); a comma-separated
# .env string is not supported.

# DATABASE (MySQL 8) — staging-specific credentials, NOT production's.
database.default.hostname = 'CHANGE_ME'
database.default.database = 'CHANGE_ME'
database.default.username = 'CHANGE_ME'
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# ENCRYPTION — generate INDEPENDENT high-entropy values per environment:
#   php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)) . PHP_EOL;"
# encryption.key and encryption.blindIndexKey MUST differ. Rotating
# encryption.key: move old value to encryption.previousKeys.
# Rotating blindIndexKey invalidates all stored email/phone blind indexes.
encryption.key = 'CHANGE_ME'
encryption.blindIndexKey = 'CHANGE_ME'
encryption.previousKeys =

# LOGGING AND MONITORING
logger.threshold = 4
monitoring.enabled = true
monitoring.fileLogEnabled = true
monitoring.auditLogEnabled = true
monitoring.auditDbEnabled = true
monitoring.slowRequestMs = 800
monitoring.slowQueryMs = 100

# RATE LIMITS AND SESSION SECURITY
security.apiRateLimitPerWindow = 60
security.apiRateLimitWindowSeconds = 60
security.apiRateLimitAnonPerWindow = 20
security.loginRateLimitPerWindow = 5
security.loginRateLimitWindowSeconds = 900
# MUST be absent or 0/false on staging — ProductionSecurityPosture logs
# critical on boot if truthy under CI_ENVIRONMENT=production.
security.disableDeviceVerificationForTesting = 0
security.trustedDeviceTtlDays = 30
session.maxConcurrent = 3
# Login email second factor: off | admins | all.
security.login_2fa_scope = admins
MFA_REQUIRED_FOR_ADMIN_OPS = true
SYSTEM_ADMIN_PRIMARY_TRANSFER_OTP_ENABLED = true

# DOMAIN POLICIES — enable only after duplicate family memberships are
# remediated. Audit query:
#   SELECT user_id, COUNT(DISTINCT family_id) AS family_count
#   FROM family_member GROUP BY user_id HAVING family_count > 1;
families.enforceSingleFamilyMembership = 0

# EMAIL — scoped SMTP. Staging may use a dedicated mailbox or log-only
# transport; credential-bearing mail uses the System transport regardless.
email.protocol = smtp
email.fromEmail = 'CHANGE_ME-staging@example.invalid'
email.fromName = 'ekklesiaONLINE Staging'
email.SMTPHost = 'CHANGE_ME'
email.SMTPUser = 'CHANGE_ME'
email.SMTPPass = 'CHANGE_ME'
email.SMTPPort = 587
email.SMTPTimeout = 5
email.SMTPCrypto = tls
# Optional: Gmail API OAuth2 transport (only if used). Never commit real values.
# email.googleClientId =
# email.googleClientSecret =

# DATABASE BACKUPS — required by build/backup_database.sh and
# build/restore_database.sh --check preflights.
backup.db.host = 'CHANGE_ME'
backup.db.port = 3306
backup.db.name = 'CHANGE_ME'
backup.db.user = 'CHANGE_ME'
backup.db.pass = 'CHANGE_ME'
backup.retentionDays = 30
backup.outputDir = writable/backups

# OPTIONAL SMS — log_only for staging unless delivery testing is needed.
sms.provider = log_only
sms.twilio_from =
sms.twilio_sid =
sms.twilio_token =
