parameters:
    level: 3
    paths:
        - app/Services
        - app/Libraries
        - app/Models
    scanFiles:
        - phpstan-stubs.php
        - app/Helpers/followup_template_helper.php
    excludePaths:
        - app/Database/Migrations/*
    reportUnmatchedIgnoredErrors: false
    parallel:
        maximumNumberOfProcesses: 1

includes:
    - phpstan-baseline.php
