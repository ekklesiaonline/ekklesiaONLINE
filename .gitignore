# macOS metadata
.DS_Store
._*

# Local environment and secrets
.env
.env.*
!.env.example
.devin/config.local.json

# Composer dependencies
/vendor/
composer.phar

# CodeIgniter runtime data
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/uploads/*
!/writable/uploads/.gitignore
/writable/mail_queue/
/writable/backups/
/writable/restore_points/
/writable/reports/
/writable/parochial-report/
/writable/*.db
/writable/*.sqlite
/writable/*.sqlite3

# User-generated public uploads
/public/uploads/

# Database backups and dumps
*.sql.bak
*.sql.gz
*.dump
*.db
*.sqlite
*.sqlite3

# PHPUnit-generated files
/build/.phpunit.cache/
/build/logs/
/build/backups/
.phpunit.result.cache
.phpunit.cache/
phpunit.xml
phpunit.xml.bak

# Local editor settings
.vscode/

# PHP runtime errors
php_errors.log
